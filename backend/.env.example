# Copy this file to .env (in the backend/ folder) and adjust if needed.
# The defaults match the MySQL container from docker-compose.yml.

DATABASE_URL=mysql+pymysql://shop:shop@127.0.0.1:3306/shop?charset=utf8mb4

# Separate database for pytest. It is dropped and recreated on every test run,
# so never point this at a database you care about.
TEST_DATABASE_URL=mysql+pymysql://shop:shop@127.0.0.1:3306/shop_test?charset=utf8mb4

# Set to true to log every SQL statement.
SQL_ECHO=false
